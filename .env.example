# Template for local configuration. Copy to .env and fill in real values:
#   cp .env.example .env
#
# Generate a fresh Django secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#
# Never commit the real .env file (it is git-ignored).

# Required. Keep this value secret.
DJANGO_SECRET_KEY=replace-me-with-a-freshly-generated-key

# "True" for local development, "False" in production.
DJANGO_DEBUG=True

# Comma-separated hostnames. Leave empty for local development.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL connection string used by every environment (see the Database
# section of ll_project/settings.py). Locally, start the database with
# `docker compose up -d db`; this URL matches the service in docker-compose.yml.
# In production, Scalingo injects DATABASE_URL automatically, so leave it unset
# there. Omit this line entirely to fall back to the same default.
DATABASE_URL=postgres://maarifa:maarifa@127.0.0.1:5433/maarifa

# Redis connection string for the cache (see the Cache section of
# ll_project/settings.py). Locally, start it with `docker compose up -d`; this
# URL matches the redis service in docker-compose.yml. In production, Scalingo
# injects REDIS_URL automatically, so leave it unset there. Omit this line
# entirely to fall back to the same default.
REDIS_URL=redis://127.0.0.1:6379/0
